<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ subject }}</title>
  <style>
    body {
      margin: 0; padding: 0;
      background: #f1f5f9;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      font-size: 15px;
      color: #1e293b;
    }
    .card {
      max-width: 660px; margin: 0 auto;
      background: #ffffff;
      border-radius: 10px; overflow: hidden;
      box-shadow: 0 2px 8px rgba(0,0,0,.08);
    }
    .header {
      background: #1e293b; color: #f8fafc;
      padding: 22px 28px;
    }
    .header h1 { margin: 0; font-size: 17px; font-weight: 600; letter-spacing: .01em; }
    .header-range { margin: 6px 0 0; font-size: 12px; color: #94a3b8; }
    .narrative {
      padding: 24px 28px;
      font-size: 15px; line-height: 1.75; color: #1e293b;
      border-bottom: 1px solid #e2e8f0;
    }
    .narrative p { margin: 0 0 14px; }
    .narrative p:last-child { margin-bottom: 0; }
    .tickets-section {
      padding: 20px 28px 24px;
    }
    .tickets-header {
      font-size: 11px; font-weight: 700; text-transform: uppercase;
      letter-spacing: .08em; color: #94a3b8;
      margin: 0 0 14px;
      display: flex; align-items: center; gap: 8px;
    }
    .tickets-header::after {
      content: ""; flex: 1; height: 1px; background: #e2e8f0;
    }
    .status-group { margin-bottom: 18px; }
    .status-label {
      font-size: 11px; font-weight: 700; text-transform: uppercase;
      letter-spacing: .06em; margin-bottom: 8px;
      display: flex; align-items: center; gap: 6px;
    }
    .dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
    .dot-done { background: #22c55e; }
    .dot-wip  { background: #f59e0b; }
    .dot-todo { background: #94a3b8; }
    .ticket-row {
      display: flex; justify-content: space-between; align-items: baseline;
      font-size: 13px; padding: 5px 0;
      border-bottom: 1px solid #f1f5f9;
      gap: 12px;
    }
    .ticket-row:last-child { border-bottom: none; }
    .ticket-title { flex: 1; }
    .ticket-title a { color: #0f172a; text-decoration: none; font-weight: 500; }
    .ticket-title a:hover { text-decoration: underline; }
    .ticket-meta { font-size: 12px; color: #94a3b8; white-space: nowrap; }
    .notices { padding: 0 28px 4px; }
    .notice {
      display: flex; gap: 8px; align-items: flex-start;
      background: #fff7ed; border-left: 4px solid #f97316;
      border-radius: 4px; padding: 8px 12px; margin-bottom: 8px;
      font-size: 13px; color: #9a3412;
    }
    .footer {
      padding: 16px 28px; border-top: 1px solid #e2e8f0;
      text-align: center; font-size: 12px; color: #94a3b8;
    }
    @media (max-width: 600px) {
      .header { padding: 16px 16px; }
      .narrative { padding: 18px 16px; }
      .tickets-section { padding: 16px 16px 20px; }
      .footer { padding: 12px 16px; }
    }
  </style>
</head>
<body>
  <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="background:#f1f5f9; padding:24px 0;">
    <tr><td align="center">
      <!--[if mso]><table width="660" cellpadding="0" cellspacing="0" role="presentation"><tr><td><![endif]-->
      <div class="card">

        <div class="header">
          <h1>{{ subject }}</h1>
          {% if time_range %}<p class="header-range">{{ time_range }}</p>{% endif %}
        </div>

        {% if notices %}
        <div class="notices">
          {% for notice in notices %}<div class="notice">⚠️ {{ notice }}</div>{% endfor %}
        </div>
        {% endif %}

        <div class="narrative">
          {% for para in narrative_paragraphs %}
          <p>{{ para }}</p>
          {% endfor %}
        </div>

        {% if done_tickets or wip_tickets or todo_tickets or confluence_items %}
        <div class="tickets-section">
          <div class="tickets-header">Supporting detail</div>

          {% if done_tickets %}
          <div class="status-group">
            <div class="status-label"><span class="dot dot-done"></span> Done ({{ done_tickets|length }})</div>
            {% for item in done_tickets %}
            <div class="ticket-row">
              <div class="ticket-title"><a href="{{ item.url | safe_url }}">{{ item.title }}</a></div>
              <div class="ticket-meta">{{ item.author }}</div>
            </div>
            {% endfor %}
          </div>
          {% endif %}

          {% if wip_tickets %}
          <div class="status-group">
            <div class="status-label"><span class="dot dot-wip"></span> In Progress ({{ wip_tickets|length }})</div>
            {% for item in wip_tickets %}
            <div class="ticket-row">
              <div class="ticket-title"><a href="{{ item.url | safe_url }}">{{ item.title }}</a></div>
              <div class="ticket-meta">{{ item.author }}</div>
            </div>
            {% endfor %}
          </div>
          {% endif %}

          {% if todo_tickets %}
          <div class="status-group">
            <div class="status-label"><span class="dot dot-todo"></span> To Do ({{ todo_tickets|length }})</div>
            {% for item in todo_tickets %}
            <div class="ticket-row">
              <div class="ticket-title"><a href="{{ item.url | safe_url }}">{{ item.title }}</a></div>
              <div class="ticket-meta">{{ item.author }}</div>
            </div>
            {% endfor %}
          </div>
          {% endif %}

          {% if confluence_items %}
          <div class="status-group">
            <div class="status-label">📄 Documentation ({{ confluence_items|length }} page{{ 's' if confluence_items|length != 1 }})</div>
            {% for item in confluence_items %}
            <div class="ticket-row">
              <div class="ticket-title"><a href="{{ item.url | safe_url }}">{{ item.title }}</a></div>
              <div class="ticket-meta">{{ item.author }}</div>
            </div>
            {% endfor %}
          </div>
          {% endif %}

        </div>
        {% endif %}

        <div class="footer">
          AI-generated summary &middot; all titles link to originals
        </div>

      </div>
      <!--[if mso]></td></tr></table><![endif]-->
    </td></tr>
  </table>
</body>
</html>
