<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ L.title }}</title>
  <style>
    body {
      margin: 0; padding: 0;
      background: #f1f5f9;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      font-size: 15px;
      color: #1e293b;
    }
    .card {
      max-width: 1200px; margin: 0 auto; text-align: left;
      background: #ffffff;
      border-radius: 10px; overflow: hidden;
      box-shadow: 0 2px 8px rgba(0,0,0,.08);
    }
    .header { background: #1e293b; color: #f8fafc; padding: 22px 28px; }
    .header h1 { margin: 0; font-size: 17px; font-weight: 600; letter-spacing: .01em; }
    .header-range { margin: 6px 0 0; font-size: 12px; color: #94a3b8; }
    .block { padding: 20px 28px; border-bottom: 1px solid #e2e8f0; }
    .block h2 { margin: 0 0 12px; font-size: 16px; font-weight: 700; color: #0f172a; }
    .block.spec { border-top: 12px solid #cbd5e1; padding-top: 28px; padding-bottom: 28px; }
    .block.spec h2 { font-size: 18px; }
    .block h3 {
      margin: 18px 0 8px; font-size: 11px; font-weight: 700; text-transform: uppercase;
      letter-spacing: .08em; color: #64748b;
    }
    .block { overflow-wrap: anywhere; word-break: break-word; }
    .block a { color: #1d4ed8; text-decoration: underline; }
    .toc { margin: 0; padding-left: 20px; font-size: 14px; line-height: 1.7; }
    .problem-banner {
      background: #fef2f2; border-left: 4px solid #dc2626; color: #991b1b;
      border-radius: 4px; padding: 10px 14px; margin-bottom: 14px; font-size: 14px; font-weight: 600;
    }
    .lst { margin: 0; padding-left: 20px; font-size: 14px; line-height: 1.6; }
    .meta { font-size: 12px; color: #64748b; margin: 0 0 12px; }
    table.t { width: 100%; max-width: 100%; border-collapse: collapse; font-size: 12px; }
    table.t th {
      text-align: left; background: #f8fafc; color: #475569; font-weight: 600;
      padding: 6px 8px; border-bottom: 2px solid #e2e8f0;
    }
    table.t td { padding: 6px 8px; border-bottom: 1px solid #f1f5f9; vertical-align: top; }
    .cls { font-weight: 600; white-space: nowrap; }
    .cls-changed { color: #b45309; }
    .cls-unchanged { color: #15803d; }
    .cls-error { color: #b91c1c; }
    .cls-excluded, .cls-not-monitored, .cls-cosmetic-only { color: #64748b; }
    .detail { display: block; color: #475569; font-weight: 400; margin-top: 2px; }
    .warn {
      background: #fff7ed; border-left: 4px solid #f97316; border-radius: 4px;
      padding: 8px 12px; margin: 0 0 8px; font-size: 13px; color: #9a3412;
    }
    .cr { font-size: 14px; line-height: 1.7; }
    .cr p { margin: 0 0 12px; }
    .effort {
      background: #f0f9ff; border-left: 4px solid #0ea5e9; border-radius: 4px;
      padding: 8px 12px; font-size: 13px; color: #0c4a6e;
    }
    .delta-item {
      border-radius: 6px; padding: 10px 14px; margin-bottom: 10px;
      background: #f8fafc; border-left: 4px solid #0ea5e9; font-size: 13px; line-height: 1.5;
    }
    .delta-item.blocking { border-left-color: #dc2626; }
    .delta-title { font-weight: 600; margin-bottom: 4px; }
    .tag-blocking {
      font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em;
      color: #ffffff; background: #dc2626; border-radius: 3px; padding: 1px 6px; margin-left: 6px;
    }
    .label { color: #64748b; font-size: 11px; font-weight: 600; text-transform: uppercase; }
    .footer { padding: 16px 28px; text-align: left; font-size: 12px; color: #94a3b8; }
    .cmdline {
      margin: 8px 0 0; font-family: "Courier New", Courier, monospace;
      font-size: 10px; color: #94a3b8; word-break: break-all;
    }
    @media (max-width: 600px) {
      .header, .block, .footer { padding-left: 16px; padding-right: 16px; }
    }
  </style>
</head>
<body>
  <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="background:#f1f5f9; padding:24px 0;">
    <tr><td align="center" style="padding:0 24px;">
      <div class="card">

        <div class="header">
          <h1>{{ L.title }}</h1>
          <p class="header-range">{{ L.generated }}: {{ generated }}</p>
        </div>

        <div class="block" id="toc">
          <h2>{{ L.toc }}</h2>
          <ol class="toc">
            {% for anchor, label in toc %}<li><a href="#{{ anchor }}">{{ label }}</a></li>{% endfor %}
          </ol>
        </div>

        <div class="block" id="overview">
          <h2>{{ L.overview }}</h2>
          {% if problem_count %}
          <div class="problem-banner">{{ problem_count }} {{ L.problems }} <a href="#errors">{{ L.errors }}</a></div>
          {% endif %}

          <h3>{{ L.with_changes }} ({{ with_changes|length }})</h3>
          {% if with_changes %}<ul class="lst">
            {% for s in with_changes %}<li><a href="#{{ s.anchor }}">{{ s.title }}</a>{% if s.url %} (<a href="{{ s.url }}" target="_blank" rel="noopener">Confluence</a>){% endif %}, {{ s.n }} {{ L.cls_changed }}</li>{% endfor %}
          </ul>{% else %}<p class="meta">{{ L.none }}</p>{% endif %}

          <h3>{{ L.without_changes }} ({{ without_changes|length }})</h3>
          {% if without_changes %}<ul class="lst">
            {% for s in without_changes %}<li>{% if s.url %}<a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.title }}</a>{% else %}{{ s.title }}{% endif %}</li>{% endfor %}
          </ul>{% else %}<p class="meta">{{ L.none }}</p>{% endif %}

          <h3>{{ L.not_analysed }} ({{ not_analysed|length }})</h3>
          {% if not_analysed %}<ul class="lst">
            {% for s in not_analysed %}<li>{% if s.url %}<a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.title }}</a>{% else %}{{ s.title }}{% endif %} ({{ s.status }})</li>{% endfor %}
          </ul>{% else %}<p class="meta">{{ L.none }}</p>{% endif %}

          <h3>{{ L.excluded_pages }} ({{ excluded|length }})</h3>
          {% if excluded %}<ul class="lst">
            {% for e in excluded %}<li>{{ e.title }} ({{ e.id }})</li>{% endfor %}
          </ul>{% else %}<p class="meta">{{ L.none }}</p>{% endif %}
        </div>

        {% for sp in specs %}
        <div class="block spec" id="{{ sp.anchor }}">
          <h2>{{ sp.title }}</h2>
          <p class="meta">
            {{ L.status }}: {{ sp.status }}
            {% if sp.jira %} &middot; {{ L.jira }}: {{ sp.jira|join(', ') }}{% endif %}
            {% if sp.url %} &middot; <a href="{{ sp.url }}" target="_blank" rel="noopener">Confluence</a>{% endif %}
          </p>

          <h3>{{ L.sources }}</h3>
          <table class="t" width="100%" cellpadding="0" cellspacing="0">
            <tr><th>{{ L.source }}</th><th>{{ L.old }}</th><th>{{ L.new }}</th><th>{{ L.classification }}</th></tr>
            {% for r in sp.sources %}
            <tr>
              <td>
                {% if r.url %}<a href="{{ r.url }}" target="_blank" rel="noopener">{{ r.name }}</a>{% else %}{{ r.name }}{% endif %}{% if r.section %} ({{ r.section }}){% endif %}
                {% for d in r.detail %}<span class="detail">{{ d|linkify }}</span>{% endfor %}
              </td>
              <td>{% if r.old_url %}<a href="{{ r.old_url }}" target="_blank" rel="noopener">{{ r.old }}</a>{% else %}{{ r.old }}{% endif %}</td>
              <td>{% if r.new_url %}<a href="{{ r.new_url }}" target="_blank" rel="noopener">{{ r.new }}</a>{% else %}{{ r.new }}{% endif %}{% if r.diff_url %}<br><a href="{{ r.diff_url }}" target="_blank" rel="noopener">{{ L.diff }}</a>{% endif %}</td>
              <td class="cls cls-{{ r.cls }}">{{ r.classification }}</td>
            </tr>
            {% endfor %}
          </table>

          {% if sp.warnings %}
          <h3>{{ L.warnings }}</h3>
          {% for w in sp.warnings %}<div class="warn">{{ w|linkify }}</div>{% endfor %}
          {% endif %}

          {% if sp.incomplete %}<div class="warn">{{ L.incomplete }}</div>{% endif %}

          {% if sp.change_request or sp.effort %}
          <h3>{{ L.change_request }}</h3>
          <div class="cr">{% for p in sp.change_request %}<p>{{ p|linkify }}</p>{% endfor %}</div>
          {% if sp.effort %}
          <div class="effort">
            <strong>{{ L.effort_ai }}:</strong>
            {{ L.size }} {{ sp.effort.size }}, {{ sp.effort.person_days }} {{ L.person_days }}
            {% if sp.effort.rationale %}<br />{{ sp.effort.rationale|linkify }}{% endif %}
          </div>
          {% endif %}
          {% endif %}

          {% if sp.delta_groups or sp.open_points %}
          <h3>{{ L.delta }}</h3>
          {% for g in sp.delta_groups %}
          <div class="label">{{ g.label }}</div>
          {% for c in g.entries %}
          <div class="delta-item{% if c.blocking %} blocking{% endif %}">
            <div class="delta-title">{{ c.affected_part|linkify }}{% if c.ids %} ({{ c.ids|join(', ') }}){% endif %}{% if c.blocking %}<span class="tag-blocking">{{ L.blocking }}</span>{% endif %}</div>
            {% if c.current_statement %}<div><span class="label">{{ L.current }}:</span> {{ c.current_statement|linkify }}</div>{% endif %}
            {% if c.change %}<div><span class="label">{{ L.change }}:</span> {{ c.change|linkify }}</div>{% endif %}
            {% if c.reason %}<div><span class="label">{{ L.reason }}:</span> {{ c.reason|linkify }}</div>{% endif %}
          </div>
          {% endfor %}
          {% endfor %}
          {% if sp.open_points %}
          <h3>{{ L.open_points }}</h3>
          <ul class="lst">
            {% for p in sp.open_points %}<li>{{ p.question|linkify }}{% if p.raised_by %} <span class="meta">({{ L.raised_by }}: {{ p.raised_by }})</span>{% endif %}</li>{% endfor %}
          </ul>
          {% endif %}
          {% endif %}
        </div>
        {% endfor %}

        <div class="block" id="errors">
          <h2>{{ L.errors }}</h2>
          {% if errors %}
          <table class="t" width="100%" cellpadding="0" cellspacing="0">
            <tr><th>{{ L.err_scope }}</th><th>{{ L.err_message }}</th><th>{{ L.err_attempts }}</th><th>{{ L.err_impact }}</th></tr>
            {% for e in errors %}
            <tr><td>{{ e.scope|linkify }}</td><td>{{ e.message|linkify }}</td><td>{{ e.attempts }}</td><td>{{ e.impact|linkify }}</td></tr>
            {% endfor %}
          </table>
          {% else %}<p class="meta">{{ L.no_errors }}</p>{% endif %}

          {% if limitations %}
          <h3>{{ L.limitations }}</h3>
          <ul class="lst">
            {% for l in limitations %}<li>{{ l.scope }}: {% if l.url %}<a href="{{ l.url }}" target="_blank" rel="noopener">{{ l.name }}</a>{% else %}{{ l.name }}{% endif %}{% if l.note %} ({{ l.note|linkify }}){% endif %}</li>{% endfor %}
          </ul>
          {% endif %}
        </div>

        <div class="footer">
          {{ L.ai_note }} &middot; {{ L.footer_cache }}: {{ report.cache_hits }} / {{ report.cache_misses }}{{ cache_corrupt_note }}
          {% if report.command_line %}<div class="cmdline">{{ L.footer_cmd }}: {{ report.command_line }}</div>{% endif %}
        </div>

      </div>
    </td></tr>
  </table>
</body>
</html>
