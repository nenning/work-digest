atlassian:
  url: https://yourcompany.atlassian.net
  email: you@company.com
  api_token: "your-api-token"   # create at id.atlassian.com/manage-profile/security/api-tokens
  jira_projects: [PROJ, OTHER]
  # jira_jql_extra: '"Team[Team]" = xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx'
  # optional — added by AND to all 3 Jira queries (before ORDER BY)
  confluence_spaces: [ENG, DOC]

m365:
  enabled: true    # set to false to skip Teams/Outlook fetching

  # tenant_id is optional — omit to use "organizations" authority
  # tenant_id: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

  # client_id: required if your tenant blocks the Azure CLI app ID (AADSTS65002 error).
  # Register your own Azure AD app (Public client, delegated permissions:
  # Mail.Read, Chat.Read, ChannelMessage.Read.All, User.Read)
  # and paste its Application (client) ID here.
  # client_id: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Email send path: smtp block present → SMTP (any platform)
#                  smtp absent + Windows → Outlook COM (opens draft or sends via Outlook app)
#                  smtp absent + non-Windows → error (add smtp block)
# Run once to store the password: python digest/main.py --setup-smtp-auth
# smtp:
#   host: smtp.office365.com
#   port: 587                  # default; 465 for SSL-only servers
#   username: you@company.com
#   # use_tls: true            # default true (STARTTLS on port 587)
#   # use_oauth2: false        # set true for M365 tenants with basic auth disabled (common default);
#                              # reuses the M365 token from --setup-auth — no separate password needed
#   # sender: you@company.com  # default: same as username

llm:
  provider: openai              # openai | anthropic | azure_openai
  api_key: "sk-..."
  model: gpt-4o                  # comma-separated for multiple: "gpt-4o, gpt-4o-mini"
  endpoint: "https://..."        # optional — overrides provider default
  fallback_model: gpt-4o-mini    # optional — comma-separated list, tried in order after all primary models fail
  # llm_workers: 4              # optional — parallel LLM calls during summarization (default: 4)
  # llm_timeout: 30             # optional — seconds before a single LLM call is cancelled and the next model tried (default: 30)

schedule:
  times: ["08:00", "13:00"]

email:
  subject_prefix: "[Digest]"
  recipient: you@company.com   # required for all send paths (SMTP and COM)

language: de   # ISO 639-1 output language for LLM summaries (de | en | fr | es | it | ...)

data_dir: ~/.digest

# Management summary mode (--mgmt-summary flag). Optional — only needed for that mode.
# mgmt_summary:
#   jira_jql: "project = PP"              # required — base JQL defining the team's tickets
#   jira_board_id: 123                    # required for --sprint lookup; find it in the board URL
#   ignore_users: []                      # display names of users to exclude (e.g. bots, testers)
#   ignore_issue_types:                   # issue types to skip entirely
#     - "Xray Test"
#     - "Test Plan"
#     - "Sub-Test Execution"
#   recipient: ""                         # optional — who to send the summary to (defaults to your own address)
