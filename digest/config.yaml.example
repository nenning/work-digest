atlassian:
  url: https://yourcompany.atlassian.net
  email: you@company.com
  api_token: "your-api-token"   # create at id.atlassian.com/manage-profile/security/api-tokens

  projects:
    - name: PROJ                            # display label (mgmt-summary section headings, console output)
      jira:
        project: PROJ                       # Jira project key
        # jql_extra: '"Team[Team]" = xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx'
        # optional — AND'd onto this project's personal-digest queries (ticket updates + new tickets)
      confluence:
        spaces: [ENG]                       # optional
      # mgmt_summary:                       # optional — omit to exclude this project from --mgmt-summary
      #   jira_jql_extra: '...'             # optional, AND'd onto "project = PROJ" + the global mgmt_summary.jira_jql
      #   jira_board_id: 123                # required only if you use --sprint for this project
      # url: https://other-tenant.atlassian.net
      #   # optional, rare — overrides atlassian.url for just this project's requests.
      #   # Credentials stay global (email/api_token/auth_type/cloud_id do not vary per
      #   # project), so this only works cleanly with auth_type: classic — classic tokens
      #   # are account-level, not site-level.
    - name: OTHER
      jira:
        project: OTHER
      confluence:
        spaces: [DOC]
      # no mgmt_summary block -> OTHER is excluded from --mgmt-summary

  # auth_type: classic          # default. Basic auth with email + a classic API token
  #                              # (works for both personal accounts and service accounts).
  # auth_type: scoped           # use for an API token with scopes (id.atlassian.com's
  #                              # "API tokens with scopes" flow). These use Bearer auth
  #                              # routed through api.atlassian.com instead of Basic auth
  #                              # against your tenant domain — Atlassian otherwise rejects
  #                              # them with a 401 regardless of the email/username tried.
  #                              # Note: a scoped token needs both Jira AND Confluence scopes
  #                              # granted if this tool uses both sources — a token with only
  #                              # Jira scopes will fail Confluence calls with a scope error.
  # cloud_id: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
  #                              # optional, only used with auth_type: scoped — auto-resolved
  #                              # from {url}/_edge/tenant_info if omitted

m365:
  enabled: true    # set to false to skip Teams/Outlook fetching

  # tenant_id is optional — omit to use "organizations" authority
  # tenant_id: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

  # client_id: required if your tenant blocks the Azure CLI app ID (AADSTS65002 error).
  # Register your own Azure AD app (Public client, delegated permissions:
  # Mail.Read, Chat.Read, ChannelMessage.Read.All, User.Read)
  # and paste its Application (client) ID here.
  # client_id: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Email send path: smtp block present → SMTP (any platform)
#                  smtp absent + Windows → Outlook COM (opens draft or sends via Outlook app)
#                  smtp absent + non-Windows → error (add smtp block)
# Run once to store the password: python digest/main.py --setup-smtp-auth
# smtp:
#   host: smtp.office365.com
#   port: 587                  # default; 465 for SSL-only servers
#   username: you@company.com
#   # use_tls: true            # default true (STARTTLS on port 587)
#   # use_oauth2: false        # set true for M365 tenants with basic auth disabled (common default);
#                              # reuses the M365 token from --setup-auth — no separate password needed
#   # sender: you@company.com  # default: same as username

llm:
  provider: openai              # openai | anthropic | azure_openai
  api_key: "sk-..."
  summary_models: gpt-4o-mini    # required — model(s) for per-item summaries (digest, spec monitor diff summaries);
                                 # comma-separated string or YAML list: items are distributed round-robin, the others are the failover
  endpoint: "https://..."        # optional — overrides provider default
  # llm_workers: 4              # optional — parallel LLM calls during summarization (default: 4)
  # llm_timeout: 30             # optional — seconds before a single LLM call is cancelled and the next model tried (default: 30)
  # heavy_models: gpt-4o        # optional — model(s) for the HEAVY calls: everything of --mgmt-summary, spec monitor change
  #                             # request / delta spec, --update-spec section rewrites, source extraction, vision fallback
  #                             # (same format; empty/absent = summary_models)
  # vision_model: gpt-4o        # optional — single model for the spec monitor's draw.io image comparison fallback
  #                             # (empty/absent = first of heavy_models, else summary_models). Same provider/key as above.

schedule:
  times: ["08:00", "13:00"]

email:
  subject_prefix: "[Digest]"
  recipient: you@company.com   # required for all send paths (SMTP and COM)

language: de   # output language for LLM summaries: ISO 639-1 code (de | en | fr | es | it | ...)
               # or a free-text override sent verbatim to the LLM, e.g. "Deutsch (Schweiz)" or "English (US)"

data_dir: ~/.digest

# Management summary mode (--mgmt-summary flag). Optional — only needed for that mode.
# Shared across every project with a mgmt_summary block above; --mgmt-summary produces
# one email with one narrative section per such project (skipping projects with no
# data in the time range). At least one project needs a mgmt_summary block, or
# --mgmt-summary errors out.
# mgmt_summary:
#   jira_jql: "statusCategory != Done"    # optional shared/base clause AND'd onto every project's own filter
#   ignore_users: []                      # display names of users to exclude (e.g. bots, testers) — global
#   ignore_issue_types:                   # issue types to skip entirely — global
#     - "Xray Test"
#     - "Test Plan"
#     - "Sub-Test Execution"
#   recipient: ""                         # optional — who to send the summary to (defaults to email.recipient).
#                                          # Single global recipient — no per-project override; one email is
#                                          # always sent to one recipient.

# Spec source monitor (--spec-monitor flag). Optional — only needed for that mode.
# Finds the detail specifications below a Confluence parent page, reads the sources
# each one pins in its "Quellen" table and reports which sources changed since.
# spec_monitor:
#   parent_page_id: "668860602"          # specs are searched below this page
#   selector:                            # how a page below it is recognised as a spec
#     type: page_properties_id           # or: label
#     value: DETAILSPEC                  # the Page Properties macro ID, or the label name
#   analysis_states: [Refined, Abgenommen, Angenommen]   # states that get the full analysis (case-insensitive);
#                                        # every other state is only listed in the report
#   recipient: ""                        # optional — falls back to mgmt_summary.recipient, then email.recipient
#   excluded_source_markers: ["Notizen", "Arbeitsnotizen", "Vorgängerfassung"]
#                                        # source rows whose name or "Verwendet für" contains one are excluded
#   llm_timeout: 240                     # seconds per LLM call of this mode (summaries, change request, rewrites)
#   workers: 4                           # parallel source lookups and diff summaries per spec
#   retry:                               # applies to every outgoing call of this mode
#     attempts: 3
#     backoff_seconds: 2                 # doubled per attempt; Retry-After honoured on 429
#     timeout_seconds: 60                # per HTTP request; downloads get twice this
#   reference_check:                     # only for --check-references
#     link_depth: 1                      # follow the links of the pages listed in Quellen this many levels and suggest
#                                        # linked pages the spec should list too (0 = off, max 2); --link-depth overrides
#     max_pages: 50                      # upper bound of pages read per spec for that (the run says when it is hit)
#   confluence_page:
#     parent_page_id: "..."              # where --publish-page creates the report page; required only for that flag
#   ticket:                              # only needed for --create-ticket
#     project: PROJ                      # Jira project key of the created ticket
#     issue_type: Story
#     labels: [cr]                       # 'spec-monitor' is always added
#     priority: Medium
#     team_id: "<team id>"               # raw id string for the team custom field
#     team_field: customfield_10001      # custom field that holds the team (default)
#     parent: PROJ-123                   # optional parent (e.g. a Feature)
#     fields: {}                         # extra raw Jira fields, passed through as given
#     remote_link: true                  # add the Confluence page as a web link on the ticket
#     link_type: Relates                 # link to the Jira tickets named on the spec page

# GitLab connection for repository sources (ADRs, API concept in the diagram repo).
# Optional; without it repo sources are listed as "not monitored". Only the doc folder of each
# repository is configured: the monitor finds the referenced document there by path, ADR number
# or name. Unreachable repositories never fail the run; they are reported in the output.
# gitlab:
#   url: https://gitlab.example.com
#   api_token: "glpat-..."               # read_api scope is enough
#   default_project: application         # NAME of the repository used for rows that say "im Repository"
#   repositories:
#     - name: application
#       project: group/application       # full "group/project" path or numeric project id
#       docs_folder: docs                # folder (or list: docs_folders: [docs, architecture]) searched for documents
#       # default_branch: main
#     - name: Diagramm-Repository        # text in a source row that selects this repository (default: the name)
#       project: group/diagrams
#       docs_folder: "."                 # "." = documents live in the repository root
#       # match: ["Diagramm-Repository"] # optional, extra selection texts
#       # documents:                     # optional explicit aliases, only if the search guesses wrong
#       #   - match: "API-Konzept"
#       #     path: API-Konzept.adoc
